// deploy/crds.yaml and deploy/operator.yaml, from the library in jsonnet/
// with the example configuration below. `npm run render` writes them;
// `npm run render -- --check` fails if they are stale.
local operator = import 'jsonnet/main.libsonnet';

local cfg = operator.config {
  namespace: 't3code',
  // One entry per StatefulSet of t3 pods; here a single one, `t3code-example`.
  tokens: [{ statefulSet: 't3code-example', secret: 't3code-api-token-example' }],
};

local header(lines) =
  std.join('', [(if l == '' then '#' else '# ' + l) + '\n' for l in ['Generated by `npm run render` from deploy/jsonnet. Do not edit.', ''] + lines]);
// The header is a comment on the first document, not a document of its own.
local yaml(objects) =
  local stream = std.manifestYamlStream(objects, indent_array_in_object=false, c_document_end=false, quote_keys=false);
  assert std.startsWith(stream, '---\n');
  std.substr(stream, 4, std.length(stream) - 4);

{
  'crds.yaml': header([
    "The operator's CustomResourceDefinitions. Cluster-scoped: apply once per",
    'cluster, before deploy/operator.yaml.',
  ]) + yaml(operator.crds),

  'operator.yaml': header([
    'The operator, for namespace `t3code`, managing the pods of one StatefulSet,',
    '`t3code-example`, with its token from Secret `t3code-api-token-example`',
    '(key `token`). For your own: change every `namespace:`, and list one',
    'source per StatefulSet in the `api-token` volume, the file named after',
    'the StatefulSet. Better: vendor deploy/jsonnet and set `config` there.',
    'README.md, Requirements, says what the t3 pods themselves need.',
  ]) + yaml(operator.objects(cfg)),
}
